# ---------------------------------------------------------------------------
# Sauda Jasa — environment variables
# Copy this file to `.env` (and `.env.local` for local dev) and fill in values.
# ---------------------------------------------------------------------------

# Supabase (Project Settings -> API)
# Public values, safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Postgres connection used by Prisma.
# In Supabase: Project Settings -> Database -> Connection string.
# Use the pooled connection (port 6543) for DATABASE_URL and the direct
# connection (port 5432) for DIRECT_URL (used by migrations).
DATABASE_URL="postgresql://postgres:password@db.your-project-ref.supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres"
