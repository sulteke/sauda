# ---------------------------------------------------------------------------
# Sauda Jasa — environment variables
# Copy this file to `.env` (and `.env.local` for local dev) and fill in values.
# ---------------------------------------------------------------------------

# Public marketplace base URL (used for robots.txt / sitemap.xml canonical links).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Supabase (Project Settings -> API)
# Public values, safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Postgres connection used by Prisma.
# In Supabase: Project Settings -> Database -> Connection string.
# Use the pooled connection (port 6543) for DATABASE_URL and the direct
# connection (port 5432) for DIRECT_URL (used by migrations).
DATABASE_URL="postgresql://postgres:password@db.your-project-ref.supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres"

# Instagram import provider
#   true  = offline MockInstagramProvider (development)
#   false = real ApifyInstagramProvider (production; requires APIFY_TOKEN)
USE_MOCK_PROVIDER="true"
# Browser mirror of USE_MOCK_PROVIDER — only controls the "Mock data" badge in the UI.
# Keep it in sync with USE_MOCK_PROVIDER.
NEXT_PUBLIC_USE_MOCK_PROVIDER="true"
# Required when USE_MOCK_PROVIDER=false. https://console.apify.com/account/integrations
APIFY_TOKEN=""
# Optional overrides:
# APIFY_INSTAGRAM_ACTOR="apify~instagram-profile-scraper"
# APIFY_TIMEOUT_MS="60000"

# Telegram publishing (BotFather token + target channel).
# Channel id can be @your_channel or a numeric -100... id; the bot must be an admin.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHANNEL_ID=""

# Discovery uses APIFY_TOKEN + USE_MOCK_PROVIDER (same as import). Optional actor overrides:
# APIFY_DISCOVERY_PROFILE_ACTOR="apify~instagram-profile-scraper"
# APIFY_DISCOVERY_HASHTAG_ACTOR="apify~instagram-hashtag-scraper"
# APIFY_DISCOVERY_TIMEOUT_MS="90000"

# AI category analyzer (Gemini). When unset, the AI stage falls back to the
# disabled provider and import stays keyword-only (fully backward compatible).
GEMINI_API_KEY=""
# Optional overrides:
# GEMINI_MODEL="gemini-2.5-flash"
# GEMINI_TIMEOUT_MS="30000"
