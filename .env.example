# ---------------------------------------------------------------------------
# Sauda Jasa — environment variables
# Copy this file to `.env` (and `.env.local` for local dev) and fill in values.
# ---------------------------------------------------------------------------

# Public marketplace base URL (used for robots.txt / sitemap.xml canonical links).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Supabase (Project Settings -> API)
# Public values, safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Postgres connection used by Prisma.
# In Supabase: Project Settings -> Database -> Connection string.
# Use the pooled connection (port 6543) for DATABASE_URL and the direct
# connection (port 5432) for DIRECT_URL (used by migrations).
DATABASE_URL="postgresql://postgres:password@db.your-project-ref.supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres"

# Instagram import provider
#   true  = offline MockInstagramProvider (development)
#   false = real ApifyInstagramProvider (production; requires APIFY_TOKEN)
USE_MOCK_PROVIDER="true"
# Browser mirror of USE_MOCK_PROVIDER — only controls the "Mock data" badge in the UI.
# Keep it in sync with USE_MOCK_PROVIDER.
NEXT_PUBLIC_USE_MOCK_PROVIDER="true"
# Required when USE_MOCK_PROVIDER=false. https://console.apify.com/account/integrations
APIFY_TOKEN=""
# Optional overrides:
# APIFY_INSTAGRAM_ACTOR="apify~instagram-profile-scraper"       # profile-level data
# APIFY_INSTAGRAM_POSTS_ACTOR="apify~instagram-scraper"         # recent posts (paginates to 30)
# APIFY_TIMEOUT_MS="60000"

# Telegram publishing (BotFather token + target channel).
# Channel id can be @your_channel or a numeric -100... id; the bot must be an admin.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHANNEL_ID=""

# Discovery uses APIFY_TOKEN + USE_MOCK_PROVIDER (same as import). Optional overrides:
# APIFY_DISCOVERY_PROFILE_ACTOR="apify~instagram-profile-scraper"
# Hashtag actor. Default returns real volume via a no-login lane; the official
# apify~instagram-scraper only returns the ~6-post anonymous sample per hashtag.
# APIFY_DISCOVERY_HASHTAG_ACTOR="dami_studio~instagram-hashtag-scraper"
# Posts fetched per run (bounded by the Vercel Hobby 60s limit; ~80 ≈ 40s).
# APIFY_DISCOVERY_RESULTS_LIMIT="80"
# How many NEW unique accounts one run aims to collect before stopping.
# APIFY_DISCOVERY_TARGET_NEW_ACCOUNTS="50"
# Provider timeout; keep below 60000 so a slow run aborts before Vercel kills it.
# APIFY_DISCOVERY_TIMEOUT_MS="55000"

# AI category analyzer (Gemini). When unset, the AI stage falls back to the
# disabled provider and import stays keyword-only (fully backward compatible).
GEMINI_API_KEY=""
# Optional overrides:
# GEMINI_MODEL="gemini-2.5-flash"
# GEMINI_TIMEOUT_MS="30000"

# Business timezone. Daily limits reset at midnight HERE, not in UTC (a Vercel
# function runs in UTC, which would roll the day over at 05:00 Almaty time).
# BUSINESS_TIMEZONE="Asia/Almaty"

# Quality gate: minimum followers for an account to be worth an AI call.
# Below it (or with no follower count) the item ends in SKIPPED_LOW_FOLLOWERS
# without ever reaching Gemini. Exactly this many qualifies.
# MIN_FOLLOWERS_FOR_ANALYSIS="5000"

# Max AI invocations per business day. Counts every call actually issued —
# including failed ones, which still consume the provider's daily quota.
# DAILY_ANALYSIS_LIMIT="20"

# Max SUCCESSFUL Telegram publications per business day. Independent of the AI
# limit; skipped, failed and pending boutiques never count toward it.
# DAILY_TELEGRAM_PUBLISH_LIMIT="20"

# --- 2GIS location discovery -------------------------------------------------
# Which store source enumerates a venue: "api" (official 2GIS Places API,
# default) or "apify" (actor fallback). The service also falls back to Apify
# automatically when the API key returns no contacts for an entire venue.
# GIS_STORE_SOURCE="api"

# 2GIS Places API key. Create one in the 2GIS Platform Manager
# (https://docs.2gis.com/en/api/search/places/overview). A demo key is free but
# capped at 1,000 total requests. NOTE: website/social links live in
# items.contact_groups, which requires a PAID permission — without it the API
# returns names and addresses only, and Instagram resolution falls back to Apify.
GIS_API_KEY=""
# Optional overrides:
# GIS_LOCALE="ru_KZ"
# GIS_TIMEOUT_MS="20000"
# GIS_API_BASE_URL="https://catalog.api.2gis.com"

# Apify actor used as the 2GIS fallback (reuses the existing APIFY_TOKEN).
# Not hardcoded — set whichever 2GIS actor the Apify account subscribes to.
# APIFY_2GIS_ACTOR="crawlerbros~2gis-places-scraper"
# GIS_APIFY_TIMEOUT_MS="55000"
