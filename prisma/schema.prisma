// Sauda Jasa — Prisma schema
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Lifecycle of a boutique inside the admin review pipeline.
///
/// APPROVED means the admin accepted the boutique for the platform (it is
/// website-visible) but it is NOT eligible for Telegram — used when a boutique
/// is outside Almaty. Almaty boutiques go straight to READY_TO_PUBLISH instead.
/// Location never removes a boutique; it only gates Telegram publication.
enum BoutiqueStatus {
  DRAFT
  NEEDS_REVIEW
  APPROVED
  READY_TO_PUBLISH
  PUBLISHED
  REJECTED
  TELEGRAM_FAILED
  ARCHIVED
}

/// Where a boutique / import originated. Instagram-only today, but the import
/// pipeline is source-agnostic so new sources slot in without schema churn.
enum ImportSource {
  INSTAGRAM
}

/// Telegram publishing state — INDEPENDENT of the approval `status`. Approval
/// accepts a boutique into the platform; publishing is a separate step that
/// decides per-boutique whether to post (today: only Almaty). Keeping them
/// decoupled lets us add more cities, channels, or publishing targets later
/// without touching the approval workflow.
///   PENDING   — approved, not yet processed by the Telegram step
///   PUBLISHED — posted to the channel
///   SKIPPED   — processed, intentionally not posted (e.g. not Almaty)
///   FAILED    — a publish attempt failed (retryable)
enum TelegramPublishStatus {
  PENDING
  PUBLISHED
  SKIPPED
  FAILED
}

/// Lifecycle of an import job. Designed to be driven by an async worker at
/// scale: a worker claims PENDING jobs, moves them PROCESSING, and lands them
/// in READY_FOR_REVIEW / COMPLETED / FAILED.
enum ImportStatus {
  PENDING
  PROCESSING
  READY_FOR_REVIEW
  COMPLETED
  FAILED
}

/// A boutique record. Populated by the import pipeline (auto-discovery), not by
/// manual data entry. `instagramHandle` is the dedup key across re-imports.
model Boutique {
  id             String         @id @default(uuid())
  name           String
  slug           String         @unique
  description    String?
  city           String?
  status         BoutiqueStatus @default(DRAFT)
  /// Detected administrative region / oblast (optional; reserved for future use).
  region         String?
  /// Detected country (e.g. "Kazakhstan"). Null when the city is unrecognized.
  country        String?
  instagramHandle String?       @unique @map("instagram_handle")
  instagramUrl   String?        @map("instagram_url")
  avatarUrl      String?        @map("avatar_url")
  bio            String?
  /// Primary auto-detected product category label (backward-compatible single value).
  category       String?
  /// Final product-category ids: auto-detected, plus manual adds, minus manual removes.
  productCategories String[]    @default([]) @map("product_categories")
  /// Final auto-detected (keyword + AI) scored breakdown + evidence — the merged "why".
  categoryScores Json?          @map("category_scores")
  /// Keyword-engine result only, kept separate so keyword evidence is never overwritten.
  keywordScores Json?           @map("keyword_scores")
  /// Raw AI provider result (categories + confidence + reasons, city, mall, address,
  /// targetAudience, priceSegment, style, summary). Null when no AI ran.
  aiResult      Json?           @map("ai_result")
  /// Whitelisted Telegram hashtags actually published for this boutique (2–5).
  /// Separate from `aiResult.hashtags`, which records only what the model said:
  /// this column is the published set, so a deterministic top-up or a backfill
  /// can fill it without ever rewriting the AI's own record. Independent of the
  /// category fields — hashtags describe how a boutique is advertised, not how
  /// it is classified.
  hashtags      String[]        @default([])
  /// Category ids an admin added by hand (Stage 3).
  manualCategoriesAdded String[] @default([]) @map("manual_categories_added")
  /// Category ids an admin removed by hand (Stage 3).
  manualCategoriesRemoved String[] @default([]) @map("manual_categories_removed")
  /// Structured business info derived from imported data (phones, links, city, hours…).
  enrichment     Json?          @map("enrichment")
  followersCount Int?           @map("followers_count")
  externalUrl    String?        @map("external_url")
  /// First recent Instagram posts captured at import time (array of post objects).
  posts          Json?
  /// Whether the source Instagram account is verified.
  isVerified        Boolean? @map("is_verified")
  /// Whether the source account is an Instagram business/professional account.
  isBusinessAccount Boolean? @map("is_business_account")
  /// Whether the source account is private.
  isPrivate         Boolean? @map("is_private")
  /// Total posts on the source account (not the number captured here).
  postsCount        Int?     @map("posts_count")
  /// Number of accounts the source account follows.
  followsCount      Int?     @map("follows_count")
  /// Physical business address, when the account publishes one (object).
  businessAddress   Json?    @map("business_address")
  /// All labeled external links on the profile (array of {title, url}).
  externalUrls      Json?    @map("external_urls")
  /// Related/suggested profiles surfaced with the profile (array).
  relatedProfiles   Json?    @map("related_profiles")
  /// Whether this boutique is queued to be pushed to the (future) Telegram channel.
  telegramQueued Boolean        @default(false) @map("telegram_queued")
  /// Telegram publishing state — independent of the approval `status`. The
  /// publisher decides whether to post (by city) and records the outcome here;
  /// approval never changes it and it never changes approval.
  telegramStatus TelegramPublishStatus @default(PENDING) @map("telegram_status")
  /// Failure reason from the last Telegram publish attempt (null on success).
  /// Stores the COMPLETE, untruncated Telegram API message for debugging.
  telegramError  String?        @map("telegram_error")
  /// Structured detail of the last publish failure (target, HTTP status, full
  /// API response, timestamp) for the UI's "View details". Null on success.
  telegramFailure Json?         @map("telegram_failure")
  /// Admin-set city used ONLY for Telegram publication eligibility, when the
  /// detected `city` is Unknown and a human confirms the boutique is relevant
  /// to the channel's city. NEVER overwrites the AI-detected `city`.
  telegramOverrideCity String?  @map("telegram_override_city")
  /// When the boutique was successfully posted to Telegram. This is the ONLY
  /// source of truth for the per-business-day publication limit, so skipped,
  /// failed, pending and approved-but-unpublished boutiques never count.
  telegramPublishedAt DateTime? @map("telegram_published_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  importJobs ImportJob[]

  @@index([status])
  @@index([telegramQueued])
  @@index([telegramStatus])
  @@index([telegramPublishedAt])
  @@map("boutiques")
}

/// A single auto-discovery attempt. Durable, auditable, and retryable — the
/// backbone of import-first onboarding at 100k+ scale.
model ImportJob {
  id         String       @id @default(uuid())
  source     ImportSource @default(INSTAGRAM)
  /// The raw URL the admin pasted.
  sourceUrl  String       @map("source_url")
  /// Extracted profile handle (dedup / lookup key). Nullable until parsed.
  handle     String?
  status     ImportStatus @default(PENDING)
  /// Untouched provider payload — lets us re-map without re-scraping.
  rawProfile Json?        @map("raw_profile")
  /// Normalized boutique draft shown in the preview and used to persist.
  preview    Json?
  /// Failure reason when status = FAILED.
  error      String?
  attempts   Int          @default(0)
  /// When an AI (Gemini) call was actually issued for this job. Stamped at the
  /// moment of invocation — BEFORE the response is known — so a failed request
  /// still counts, because it still consumed the provider's daily quota. This
  /// is the ONLY source of truth for the per-business-day analysis limit.
  analyzedAt DateTime?    @map("analyzed_at")
  /// Supabase user id of the admin who ran the import.
  createdBy  String?      @map("created_by")

  boutiqueId String?   @map("boutique_id")
  boutique   Boutique? @relation(fields: [boutiqueId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([handle])
  @@index([boutiqueId])
  @@index([analyzedAt])
  @@map("import_jobs")
}

/// Lifecycle of a queued bulk-import URL. The import runs as TWO independent
/// stages so no single serverless invocation combines the slow Apify scrape
/// with the Gemini analysis (which together can exceed the platform timeout):
///
///   Stage 1 — Parse   : PENDING_PARSE → PARSING → PENDING_ANALYSIS (Apify only, no AI)
///   Stage 2 — Analyze : PENDING_ANALYSIS → ANALYZING → READY_FOR_REVIEW (Gemini only)
///
/// Parse hands straight off to PENDING_ANALYSIS on success. Failures are
/// stage-scoped and retryable independently: PARSE_FAILED re-runs the scrape;
/// ANALYSIS_FAILED re-runs only Gemini (the parsed data is reused, so Apify is
/// NEVER repeated once Parse has succeeded).
///
/// Before Analyze spends an AI call, a quality gate runs on the parsed profile.
/// Accounts below the follower threshold (or with no follower count at all)
/// land in SKIPPED_LOW_FOLLOWERS — a TERMINAL, non-failure state that is never
/// retried and never consumes AI quota. Their parsed data is preserved.
///
/// The legacy PENDING/PROCESSING/COMPLETED/FAILED values are retained only so
/// rows written before the two-stage split stay valid; new rows never use them.
enum ImportQueueStatus {
  PENDING_PARSE
  PARSING
  PENDING_ANALYSIS
  ANALYZING
  READY_FOR_REVIEW
  PARSE_FAILED
  ANALYSIS_FAILED
  /// Terminal: below the follower quality gate (or follower count unavailable),
  /// so Gemini was never called. NOT a failure and never retried for analysis.
  SKIPPED_LOW_FOLLOWERS
  // Legacy (pre two-stage split) — kept for backward compatibility only.
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

/// A bulk-import work item: one pasted Instagram URL driven through the
/// two-stage import pipeline. Processed oldest-first by processNextImport(),
/// one stage per call. `importJobId` links to the ImportJob created by Parse,
/// so Analyze can reload the parsed profile/posts without re-scraping.
model ImportQueue {
  id           String            @id @default(uuid())
  instagramUrl String            @map("instagram_url")
  status       ImportQueueStatus @default(PENDING_PARSE)
  /// ImportJob produced by the Parse stage (holds the raw profile + preview).
  importJobId  String?           @map("import_job_id")
  error        String?
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  @@index([status])
  @@map("import_queue")
}

/// What a discovery run was seeded from.
enum DiscoverySeedType {
  PROFILE
  HASHTAG
}

/// Lifecycle of a discovered candidate account.
enum DiscoveryCandidateStatus {
  NEW
  QUEUED
  DISMISSED
}

/// A candidate boutique account found by discovery. NOT imported — the admin
/// reviews these and sends the good ones into the existing import queue.
model DiscoveryCandidate {
  id           String                   @id @default(uuid())
  handle       String
  instagramUrl String                   @map("instagram_url")
  seedType     DiscoverySeedType        @map("seed_type")
  seedValue    String                   @map("seed_value")
  source       String?
  status       DiscoveryCandidateStatus @default(NEW)
  createdAt    DateTime                 @default(now()) @map("created_at")
  updatedAt    DateTime                 @updatedAt @map("updated_at")

  @@unique([handle, seedValue])
  @@index([status])
  @@map("discovery_candidates")
}
